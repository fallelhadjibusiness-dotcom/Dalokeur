// Dalokeur — schéma PostgreSQL. Montants en FCFA entiers.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  CLIENT
  PROVIDER
  ADMIN
}

enum ProviderStatus {
  PENDING
  VERIFIED
  REJECTED
  SUSPENDED
}

enum RequestStatus {
  NEW
  PENDING
  ASSIGNED
  ACCEPTED
  EN_ROUTE
  ARRIVED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum RequestMode {
  URGENT
  SCHEDULED
}

enum PriceMode {
  FIXED_ESTIMATE
  QUOTE_AFTER_DIAGNOSIS
}

enum TrackingPolicy {
  NONE
  LIVE_ON_CONSENT
}

enum AssignmentStatus {
  OFFERED
  ACCEPTED
  DECLINED
  CANCELLED
  EXPIRED
}

enum DisputeStatus {
  OPEN
  IN_REVIEW
  RESOLVED
  REJECTED
}

enum DocumentStatus {
  PENDING
  APPROVED
  REJECTED
}

enum LocationSource {
  GPS
  PIN
  MANUAL
}

enum ListingType {
  RENT
  SALE
}

enum PropertyType {
  APARTMENT
  VILLA
  STUDIO
  LAND
  OFFICE
}

enum VisitStatus {
  REQUESTED
  CONFIRMED
  DONE
  CANCELLED
}

// ───────── Identité ─────────

model User {
  id           String    @id @default(uuid()) @db.Uuid
  phone        String    @unique
  email        String?   @unique
  passwordHash String    @map("password_hash")
  fullName     String    @map("full_name")
  avatarUrl    String?   @map("avatar_url")
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  roles            UserRole[]
  providerProfile  ProviderProfile?
  requests         ServiceRequest[]       @relation("ClientRequests")
  messages         Message[]
  reviewsGiven     Review[]
  wallet           Wallet?
  keurPoints       KeurPoints?
  keurTransactions KeurPointTransaction[]
  notifications    Notification[]
  locations        Location[]
  adminActions     AdminAction[]
  visits           PropertyVisit[]
  disputesOpened   Dispute[]

  @@map("users")
}

model UserRole {
  userId String @map("user_id") @db.Uuid
  role   Role
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, role])
  @@map("user_roles")
}

// ───────── Prestataires ─────────

model ProviderProfile {
  id              String         @id @default(uuid()) @db.Uuid
  userId          String         @unique @map("user_id") @db.Uuid
  jobTitle        String         @map("job_title")
  bio             String?
  experienceYears Int            @default(0) @map("experience_years")
  zones           String[]
  available       Boolean        @default(true)
  status          ProviderStatus @default(PENDING)
  ratingAvg       Decimal        @default(0) @map("rating_avg") @db.Decimal(2, 1)
  missionsDone    Int            @default(0) @map("missions_done")
  verifiedAt      DateTime?      @map("verified_at")
  verifiedById    String?        @map("verified_by") @db.Uuid
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  documents   ProviderDocument[]
  services    ProviderService[]
  assignments Assignment[]
  reviews     Review[]

  @@map("provider_profiles")
}

model ProviderService {
  providerId String          @map("provider_id") @db.Uuid
  serviceId  String          @map("service_id") @db.Uuid
  provider   ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)
  service    Service         @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([providerId, serviceId])
  @@map("provider_services")
}

// Accès réservé à l'administrateur (jamais exposé au client ni au prestataire via l'API publique).
model ProviderDocument {
  id         String         @id @default(uuid()) @db.Uuid
  providerId String         @map("provider_id") @db.Uuid
  kind       String
  fileKey    String         @map("file_key")
  status     DocumentStatus @default(PENDING)
  reviewedBy String?        @map("reviewed_by") @db.Uuid
  reviewedAt DateTime?      @map("reviewed_at")
  createdAt  DateTime       @default(now()) @map("created_at")

  provider ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@map("provider_documents")
}

// ───────── Catalogue ─────────

model ServiceCategory {
  id        String  @id @default(uuid()) @db.Uuid
  slug      String  @unique
  name      String
  icon      String?
  sortOrder Int     @default(0) @map("sort_order")
  isLaunch  Boolean @default(false) @map("is_launch")
  isActive  Boolean @default(true) @map("is_active")

  services Service[]

  @@map("service_categories")
}

model Service {
  id               String         @id @default(uuid()) @db.Uuid
  categoryId       String         @map("category_id") @db.Uuid
  slug             String         @unique
  name             String
  description      String?
  priceMode        PriceMode      @default(FIXED_ESTIMATE) @map("price_mode")
  basePriceFcfa    Int?           @map("base_price_fcfa")
  transportFeeFcfa Int?           @map("transport_fee_fcfa") // frais de déplacement/livraison : seuls frais réductibles par les points Keur
  trackingPolicy   TrackingPolicy @default(NONE) @map("tracking_policy")
  allowsUrgent     Boolean        @default(false) @map("allows_urgent")
  isActive         Boolean        @default(true) @map("is_active")

  category  ServiceCategory   @relation(fields: [categoryId], references: [id])
  requests  ServiceRequest[]
  providers ProviderService[]

  @@map("services")
}

// ───────── Géolocalisation ─────────
// lat/lng exacts : visibles seulement par le client, le prestataire assigné (après acceptation) et l'admin.
// approxLat/approxLng : arrondis (~500 m), seule version visible avant acceptation.

model Location {
  id          String         @id @default(uuid()) @db.Uuid
  ownerUserId String         @map("owner_user_id") @db.Uuid
  lat         Float?
  lng         Float?
  accuracyM   Float?         @map("accuracy_m")
  addressLine String         @map("address_line")
  district    String
  landmark    String
  approxLat   Float?         @map("approx_lat")
  approxLng   Float?         @map("approx_lng")
  source      LocationSource @default(MANUAL)
  capturedAt  DateTime       @default(now()) @map("captured_at")

  owner    User             @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  requests ServiceRequest[]

  @@map("locations")
}

// ───────── Demandes et missions ─────────

model ServiceRequest {
  id               String        @id @default(uuid()) @db.Uuid
  reference        String        @unique
  clientId         String        @map("client_id") @db.Uuid
  serviceId        String        @map("service_id") @db.Uuid
  mode             RequestMode
  description      String
  photoKeys        String[]      @map("photo_keys")
  locationId       String        @map("location_id") @db.Uuid
  zone             String
  scheduledAt      DateTime?     @map("scheduled_at")
  priceMode        PriceMode     @map("price_mode")
  estimateFcfa     Int?          @map("estimate_fcfa")
  keurPointsUsed   Int           @default(0) @map("keur_points_used")
  transportFeeFcfa Int?          @map("transport_fee_fcfa") // copie du tarif au moment de la demande
  keurDiscountFcfa Int           @default(0) @map("keur_discount_fcfa")
  status           RequestStatus @default(NEW)
  cancelledBy      String?       @map("cancelled_by") @db.Uuid
  cancelReason     String?       @map("cancel_reason")
  expiresAt        DateTime?     @map("expires_at")
  completedAt      DateTime?     @map("completed_at")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  client   User     @relation("ClientRequests", fields: [clientId], references: [id])
  service  Service  @relation(fields: [serviceId], references: [id])
  location Location @relation(fields: [locationId], references: [id])

  assignments Assignment[]
  history     RequestStatusHistory[]
  messages    Message[]
  review      Review?
  disputes    Dispute[]
  visit       PropertyVisit?

  @@index([status, zone, serviceId])
  @@index([clientId, createdAt])
  @@map("service_requests")
}

model Assignment {
  id            String           @id @default(uuid()) @db.Uuid
  requestId     String           @map("request_id") @db.Uuid
  providerId    String           @map("provider_id") @db.Uuid
  status        AssignmentStatus @default(OFFERED)
  assignedBy    String?          @map("assigned_by") @db.Uuid
  offeredAt     DateTime         @default(now()) @map("offered_at")
  respondedAt   DateTime?        @map("responded_at")
  declineReason String?          @map("decline_reason")

  request  ServiceRequest       @relation(fields: [requestId], references: [id], onDelete: Cascade)
  provider ProviderProfile      @relation(fields: [providerId], references: [id])
  live     LiveLocationUpdate[]

  @@unique([requestId, providerId])
  @@index([providerId, status])
  @@map("assignments")
}

// Contrainte SQL ajoutée en migration : un seul assignment ACCEPTED par demande
// CREATE UNIQUE INDEX one_accepted_per_request ON assignments(request_id) WHERE status = 'ACCEPTED';

model RequestStatusHistory {
  id         String         @id @default(uuid()) @db.Uuid
  requestId  String         @map("request_id") @db.Uuid
  fromStatus RequestStatus? @map("from_status")
  toStatus   RequestStatus  @map("to_status")
  actorId    String?        @map("actor_id") @db.Uuid
  note       String?
  createdAt  DateTime       @default(now()) @map("created_at")

  request ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId, createdAt])
  @@map("request_status_history")
}

// Purgée 24 h après la fin de la mission (tâche planifiée).
model LiveLocationUpdate {
  id            String    @id @default(uuid()) @db.Uuid
  assignmentId  String    @map("assignment_id") @db.Uuid
  lat           Float
  lng           Float
  accuracyM     Float?    @map("accuracy_m")
  heading       Float?
  recordedAt    DateTime  @default(now()) @map("recorded_at")
  consentAt     DateTime  @map("consent_at")
  sharingActive Boolean   @default(true) @map("sharing_active")
  startedAt     DateTime  @map("started_at")
  endedAt       DateTime? @map("ended_at")

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  @@index([assignmentId, recordedAt])
  @@map("live_location_updates")
}

// ───────── Échanges et confiance ─────────

model Message {
  id            String    @id @default(uuid()) @db.Uuid
  requestId     String    @map("request_id") @db.Uuid
  senderId      String    @map("sender_id") @db.Uuid
  body          String
  attachmentKey String?   @map("attachment_key")
  readAt        DateTime? @map("read_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  request ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  sender  User           @relation(fields: [senderId], references: [id])

  @@index([requestId, createdAt])
  @@map("messages")
}

model Review {
  id         String   @id @default(uuid()) @db.Uuid
  requestId  String   @unique @map("request_id") @db.Uuid // un seul avis par mission
  clientId   String   @map("client_id") @db.Uuid
  providerId String   @map("provider_id") @db.Uuid
  rating     Int // 1..5, CHECK ajouté en migration
  comment    String?
  isHidden   Boolean  @default(false) @map("is_hidden")
  createdAt  DateTime @default(now()) @map("created_at")

  request  ServiceRequest  @relation(fields: [requestId], references: [id])
  client   User            @relation(fields: [clientId], references: [id])
  provider ProviderProfile @relation(fields: [providerId], references: [id])

  @@map("reviews")
}

model Dispute {
  id         String        @id @default(uuid()) @db.Uuid
  requestId  String        @map("request_id") @db.Uuid
  openedBy   String        @map("opened_by") @db.Uuid
  reason     String
  status     DisputeStatus @default(OPEN)
  resolution String?
  resolvedBy String?       @map("resolved_by") @db.Uuid
  createdAt  DateTime      @default(now()) @map("created_at")

  request ServiceRequest @relation(fields: [requestId], references: [id])
  opener  User           @relation(fields: [openedBy], references: [id])

  @@map("disputes")
}

model Notification {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  kind      String
  title     String
  body      String
  data      Json?
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@map("notifications")
}

// ───────── Portefeuille démo et points Keur (strictement séparés) ─────────

model Wallet {
  id          String  @id @default(uuid()) @db.Uuid
  userId      String  @unique @map("user_id") @db.Uuid
  balanceFcfa Int     @default(0) @map("balance_fcfa")
  isDemo      Boolean @default(true) @map("is_demo")

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions WalletTransaction[]

  @@map("wallets")
}

model WalletTransaction {
  id         String   @id @default(uuid()) @db.Uuid
  walletId   String   @map("wallet_id") @db.Uuid
  kind       String
  amountFcfa Int      @map("amount_fcfa")
  requestId  String?  @map("request_id") @db.Uuid
  note       String?
  createdAt  DateTime @default(now()) @map("created_at")

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@map("wallet_transactions")
}

model KeurPoints {
  id      String @id @default(uuid()) @db.Uuid
  userId  String @unique @map("user_id") @db.Uuid
  balance Int    @default(0) // CHECK balance >= 0 en migration

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("keur_points")
}

model KeurPointTransaction {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  delta     Int
  reason    String
  requestId String?  @map("request_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("keur_point_transactions")
}

// ───────── Immobilier (modèle prêt, interface en P2) ─────────

model Property {
  id           String       @id @default(uuid()) @db.Uuid
  title        String
  listingType  ListingType  @map("listing_type")
  propertyType PropertyType @map("property_type")
  priceFcfa    Int          @map("price_fcfa")
  district     String
  approxLat    Float?       @map("approx_lat")
  approxLng    Float?       @map("approx_lng")
  exactAddress String?      @map("exact_address") // révélée après validation de la visite
  description  String
  photoKeys    String[]     @map("photo_keys")
  isActive     Boolean      @default(true) @map("is_active")
  createdAt    DateTime     @default(now()) @map("created_at")

  visits PropertyVisit[]

  @@map("properties")
}

model PropertyVisit {
  id          String      @id @default(uuid()) @db.Uuid
  propertyId  String      @map("property_id") @db.Uuid
  clientId    String      @map("client_id") @db.Uuid
  requestId   String?     @unique @map("request_id") @db.Uuid
  scheduledAt DateTime?   @map("scheduled_at")
  status      VisitStatus @default(REQUESTED)
  createdAt   DateTime    @default(now()) @map("created_at")

  property Property        @relation(fields: [propertyId], references: [id])
  client   User            @relation(fields: [clientId], references: [id])
  request  ServiceRequest? @relation(fields: [requestId], references: [id])

  @@map("property_visits")
}

// ───────── Administration ─────────

model AdminAction {
  id         String   @id @default(uuid()) @db.Uuid
  adminId    String   @map("admin_id") @db.Uuid
  action     String
  targetType String   @map("target_type")
  targetId   String?  @map("target_id")
  details    Json?
  createdAt  DateTime @default(now()) @map("created_at")

  admin User @relation(fields: [adminId], references: [id])

  @@index([adminId, createdAt])
  @@map("admin_actions")
}

model Setting {
  key   String @id
  value Json

  @@map("settings")
}
