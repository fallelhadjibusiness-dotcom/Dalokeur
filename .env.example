# Base PostgreSQL (Neon / Supabase). Ne jamais commiter .env
DATABASE_URL="postgresql://user:password@host:5432/dalokeur?sslmode=require"
DIRECT_URL="postgresql://user:password@host:5432/dalokeur?sslmode=require"

# Auth.js — générer avec: openssl rand -base64 32
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# Carte (clé PUBLIQUE, à restreindre par domaine chez le fournisseur)
NEXT_PUBLIC_MAP_STYLE_URL=""
NEXT_PUBLIC_MAP_KEY=""

# Serveur uniquement (étapes suivantes)
ABLY_API_KEY=""
BLOB_READ_WRITE_TOKEN=""
CRON_SECRET=""

# Seed — compte administrateur initial
ADMIN_SEED_PHONE="+221770000000"
ADMIN_SEED_EMAIL="admin@dalokeur.sn"
ADMIN_SEED_PASSWORD=""

# Carte : URL de style MapLibre (ex. MapTiler : https://api.maptiler.com/maps/streets-v2/style.json). La clé est ajoutée en ?key=.
# Sans URL, repli OpenStreetMap (développement uniquement : tuiles publiques non prévues pour la production).
# NEXT_PUBLIC_MAP_STYLE_URL / NEXT_PUBLIC_MAP_KEY sont publiques : restreignez la clé par domaine chez le fournisseur.

# Sécurité admin : exiger la double authentification (TOTP) pour accéder à /admin
REQUIRE_ADMIN_2FA="false"
# Clé de chiffrement des secrets 2FA (facultatif ; sinon dérivée de AUTH_SECRET). Changer cette clé invalide les 2FA existantes.
TOTP_ENCRYPTION_KEY=""
